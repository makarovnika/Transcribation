<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd Agent для локального транскрибатора.

  Установка:   bin/svc-install.sh
  Снять:       bin/svc-uninstall.sh
  Рестарт:     bin/svc-restart.sh
  Логи:        bin/svc-logs.sh

  Файл шаблон — реальный plist после установки лежит в
  ~/Library/LaunchAgents/com.muraveika.transcriber.plist. При изменении
  путей или env надо отредактировать шаблон и переустановить через svc-install.sh.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.muraveika.transcriber</string>

  <!-- python из venv проекта + сам app.py. Никакого глобального python. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/muraveika/transcriber/.venv/bin/python</string>
    <string>-u</string>
    <string>/Users/muraveika/transcriber/app.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/muraveika/transcriber</string>

  <!-- Запуск при логине пользователя. -->
  <key>RunAtLoad</key>
  <true/>

  <!--
    KeepAlive: рестартим только при крахе. SuccessfulExit=false не нужен
    отдельно — Crashed=true уже задаёт стратегию. ThrottleInterval защищает
    от зацикленного рестарта при синтаксической ошибке в коде.
  -->
  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- Логи. ./logs/ в .gitignore — туда же smaze. -->
  <key>StandardOutPath</key>
  <string>/Users/muraveika/transcriber/logs/transcriber.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/muraveika/transcriber/logs/transcriber.err.log</string>

  <!--
    HOME нужен для чтения ~/.config/transcriber/config.json (HF-токен) и
    ~/.cache/huggingface/ (кэш моделей). PATH с homebrew — чтобы python нашёл ffmpeg.
    PYTHONUNBUFFERED — стримим логи без буферизации.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/muraveika</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!--
    Interactive — сервис «пользовательский», умирает при logout (что нам и надо
    — это локальный UI, чужому смысла нет).
    Nice 5 — небольшой даунгрейд приоритета, чтобы whisper/pyannote не мешали
    Safari и т.п.
  -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
