# Скопируй в .env и заполни своими значениями.
# .env закоммичен в .gitignore — он не попадёт в репозиторий.

# HuggingFace токен для скачивания pyannote/speaker-diarization-3.1.
# Получить: https://huggingface.co/settings/tokens
# Перед получением — принять условия модели:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# Адрес и порт Gradio. По умолчанию 127.0.0.1:7860.
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
